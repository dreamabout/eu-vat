{
    "name": "kaikei/eu-vat",
    "description": "EU VAT rates with point-in-time lookup, territorial exceptions, and gross-first VAT calculation. Rates are synced from the European Commission's TEDB and shipped as a committed snapshot.",
    "type": "library",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "ext-bcmath": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "Kaikei\\EuVat\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kaikei\\EuVat\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/regenerate-rates"
    ],
    "scripts": {
        "check": [
            "@cs",
            "@stan",
            "@test"
        ],
        "cs": "php-cs-fixer fix --dry-run --diff --allow-risky=yes",
        "cs-fix": "php-cs-fixer fix --allow-risky=yes",
        "stan": "phpstan analyse",
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
